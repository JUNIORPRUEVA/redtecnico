# ============================================
# Red Técnico Fulltech — Variables de entorno
# Copia este archivo a .env.local y completa los valores
# ============================================

# --- Supabase ---
# URL del proyecto Supabase (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Anon key pública (segura para el frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Service role key (SOLO en servidor, NUNCA exponer en frontend)
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# --- App ---
# URL base de la aplicación (para enlaces y PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Producción / EasyPanel ---
# URL directa de PostgreSQL oficial. Mantener privada en el servidor.
DATABASE_URL=postgres://usuario:password@host:puerto/base?sslmode=disable

# Usuario inicial. Usado por `npm run admin:create` en el servidor.
ADMIN_EMAIL=junior@gmail.com
ADMIN_PASSWORD=cambiar-en-produccion
ADMIN_FULL_NAME=Junior Admin

# --- Notificaciones (futuro) ---
# VAPID keys para Web Push (opcional, fase futura)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Mapas (futuro) ---
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=
